{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agda-evidence read-only unfinished goal observation v1",
  "description": "Prompt-bounded goal listings and one source-pinned selected type/context query. Inspection is not proof completion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "observationId", "snapshot", "resolution", "listing", "query", "execution", "transcript", "transport", "result"],
  "properties": {
    "format": {"const": "agda-evidence/goal-observation-v1"},
    "observationId": {"$ref": "#/$defs/digest"},
    "snapshot": {"$ref": "type-observation-v1.schema.json#/properties/snapshot"},
    "resolution": {"$ref": "type-observation-v1.schema.json#/properties/resolution"},
    "listing": {
      "oneOf": [
        {"type": "null"},
        {"allOf": [
          {"$ref": "#"},
          {"properties": {"listing": {"type": "null"}, "query": {"properties": {"operation": {"const": "list"}}}}}
        ]}
      ]
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sourceSha256", "operation", "goalId", "includes", "safe", "rewrite", "loadPolicy"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "sourceSha256": {"$ref": "#/$defs/digest"},
        "operation": {"enum": ["list", "inspect"]},
        "goalId": {"type": ["integer", "null"], "minimum": 0},
        "includes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "safe": {"type": "boolean"},
        "rewrite": {"const": "Simplified"},
        "loadPolicy": {"const": "unfinished-no-diagnostics-v1"}
      }
    },
    "execution": {"$ref": "type-observation-v1.schema.json#/properties/execution"},
    "transcript": {
      "type": "array", "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["phase", "request", "responses", "complete"],
        "properties": {
          "phase": {"enum": ["startup", "load", "goal"]},
          "request": {"type": ["string", "null"]},
          "complete": {"type": "boolean"},
          "responses": {"type": "array", "items": {"type": "object", "required": ["kind"], "properties": {"kind": {"type": "string"}}}}
        }
      }
    },
    "transport": {"$ref": "type-observation-v1.schema.json#/properties/transport"},
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "goals", "invisibleGoals", "selected"],
      "properties": {
        "status": {"enum": ["listed", "inspected", "load-error", "load-blocked", "selection-error", "query-error", "timed-out", "output-limit", "protocol-error", "execution-error"]},
        "goals": {"type": "array", "items": {"$ref": "#/$defs/goal"}},
        "invisibleGoals": {"type": "array"},
        "selected": {"oneOf": [
          {"type": "null"},
          {
            "type": "object", "additionalProperties": false,
            "required": ["id", "range", "type", "entries", "boundary", "outputForms"],
            "properties": {
              "id": {"type": "integer", "minimum": 0},
              "range": {"$ref": "#/$defs/ranges"},
              "type": {"type": "string", "minLength": 1},
              "entries": {"type": "array", "items": {
                "type": "object", "required": ["originalName", "reifiedName", "binding", "inScope"],
                "properties": {"originalName": {"type": "string"}, "reifiedName": {"type": "string"}, "binding": {"type": "string"}, "inScope": {"type": "boolean"}}
              }},
              "boundary": {"type": "array", "items": {"type": "string"}},
              "outputForms": {"type": "array", "items": {"type": "string"}}
            }
          }
        ]}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"query": {"properties": {"operation": {"const": "list"}}}}},
     "then": {"properties": {"listing": {"type": "null"}, "query": {"properties": {"goalId": {"type": "null"}}}, "transcript": {"maxItems": 2}}},
     "else": {"properties": {"listing": {"type": "object"}, "query": {"properties": {"goalId": {"type": "integer", "minimum": 0}}}}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "goal": {"type": "object", "additionalProperties": false, "required": ["id", "range", "type"],
      "properties": {"id": {"type": "integer", "minimum": 0}, "range": {"$ref": "#/$defs/ranges"}, "type": {"type": "string", "minLength": 1}}},
    "ranges": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": {"start": {"$ref": "#/$defs/position"}, "end": {"$ref": "#/$defs/position"}}}},
    "position": {"type": "object", "additionalProperties": false, "required": ["pos", "line", "col"],
      "properties": {"pos": {"type": "integer", "minimum": 1}, "line": {"type": "integer", "minimum": 1}, "col": {"type": "integer", "minimum": 1}}}
  }
}
